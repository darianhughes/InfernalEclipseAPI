		Tooltip:
			'''
			1 召唤标记伤害
			被此鞭击中的敌怪在下次被仆从攻击时发射一个沙球
			沙球受重力下落并造成40%伤害
			它会在方块上撞击时爆炸，伤害附近的敌人
			'''
	}

	DarkMandibleLash: {
		DisplayName: 暗黑颚骨鞭
		Tooltip:
			'''
			2 召唤标记伤害
			被此鞭击中的敌怪在下次被仆从攻击时发射一个沙球
