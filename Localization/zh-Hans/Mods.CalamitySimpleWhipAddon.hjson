			'''
	}

	BuddyEmblem: {
		DisplayName: 羁绊徽章
		Tooltip:
			'''
			当仅有一个仆从在场时，大幅提高其伤害
			该仆从的伤害会根据未使用的召唤栏位数量进一步增加
			此效果增强越多，仆从体型会略微变大
			部分仆从无法受益于体型效果
			削弱部分召唤标记效果
			“就决定是你了！”
			'''
	}

	StrikerEmblem: {
		DisplayName: 鞭宗徽章
		Tooltip:
			'''
			无法再召唤仆从或哨兵
			鞭子命中敌人时会额外攻击三次，每次造成33%伤害
			额外攻击可受召唤标记伤害及效果加成
			增加10%鞭子范围
			每个空闲仆从栏位都会使召唤伤害提升10%
			"去死吧，怪物！"
			'''
	}
}
