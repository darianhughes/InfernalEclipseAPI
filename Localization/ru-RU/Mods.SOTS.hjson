VisionAmuletTextList: {
	4: Увеличивает критический урон на 5%, и на 10% в хардмоде
	6:
		'''
		Увеличивает максимальный запас здоровья на 20
		Увеличивает урон на 5%, и на 10% в хардмоде
		'''
}

VisionAmuletTextList2: {
	1:
		'''

		Снижает расход маны на 20%, и на 25% в хардмоде
		'''
	3:
		'''

		Даёт доступ к рецептам верстака, печи и наковальни
		В хардмоде также даёт доступ к рецептам алхимического стола
		Увеличивает максимальный запас маны и количество маны, получаемое от зелий, на 40
		'''
	4:
		'''

		Наносимый урон получит 10% бонуса от всех бонусов к другим типам урона
		'''
	5:
		'''

		Снижает эффективность вражеской защиты на 5%, и на 10% в хардмоде
		'''
}

NPCs.CorpseBloom.DisplayName: Гнилоцвет

Items: {
	Sharanga.DisplayName: Коданда
	Dreamcatcher.DisplayName: Талисман грёз
	EnchantedPickaxe.DisplayName: Мистическая кирка
	VigorPotion.Tooltip: Позволяет совершить 25 рывков
	HarvestersScythe.Tooltip:
		'''
		Увеличивает критический урон на 5%
		С 10% шансом с врагов будет выпадать вдвое больше предметов
		Шанс увеличивается до 20%, если враг был добит критическим ударом
		'''
	RockCandy.Tooltip:
		'''
		Увеличивает мощность кирки на 4
		Увеличивает скорости добычи, ближнего боя и передвижения на 5%
		'''
	HydrokineticAntennae.Tooltip:
		'''
		Использует гидрокинетику для увеличения радиуса действия оружия короткой дистанции, таких как хлысты и оружие ближнего боя
		Снижает истинный урон ближнего боя 15%
		'''
	FrostArtifactHelmet.Tooltip: Увеличивает урон ближнего боя и стрелковый урон на 15%
	FrostArtifactChestplate.Tooltip: Увеличивает стрелковый шанс критического удара и критического удара ближнего боя на 15%

	ElementalBreastplate: {
		DisplayName: Элементальный нагрудник
		Tooltip:
			'''
			Увеличивает урон ближнего боя и призывателя на 10%
			Увеличивает регенерацию здоровья на 4
			Нажмите клавишу «{$SOTS.Keybinds.ArmorSet.DisplayName}» ({0}), чтобы телепортироваться в место курсора
			Телепортация через врагов наносит им урон, равный 200% от вашей защиты
			Телепортация имеет 15 секунд перезарядки, во время которой скорость ближнего боя увеличивается на 40%
			'''
	}
}

