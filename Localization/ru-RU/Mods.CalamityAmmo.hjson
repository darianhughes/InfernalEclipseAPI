		DisplayName: Вульфрумовая катушка
		Tooltip:
			'''
			Увеличивает стрелковый урон на 5%
			Немного увеличивает скорость стрелковых снарядов
			'''
	}

	WulfrumBullet: {
		DisplayName: Wulfrum Scrap Bullet
		Tooltip:
			'''
			Излучает вульфрумовые энергетические лучи с небольшой самонаводкой
			"Последний хамон, сынок."
			'''
	}

	SoulBullet: {
		DisplayName: Пуля души
		Tooltip:
			'''
			Самонаводится на ближайшего врага, наносит половину урона, но пронзает три цели, с уменьшением урона при каждом попадании
			"Создана путём вдавливания несчастных душ в гильзы, может привлекать такие же жалкие души."
			'''
	}
}
