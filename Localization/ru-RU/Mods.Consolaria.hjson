Items: {
	OstaraHat: {
		DisplayName: Шляпа Остары
		Tooltip: Увеличивает скорость передвижения на 7%
		SetBonus:
			'''
			Позволяет совершить авто-прыжок и даёт невосприимчивость к урону от падения
			При распрыжке вылетают 5 пронзающих ножей
			Ножи вылетают до 5 раз подряд, а после будут восстанавливаться 3 секунды
			'''
	}

	JadeSeal: {
		DisplayName: Нефритовая печать
		Tooltip:
			'''
			Нажмите ЛКМ, чтобы призвать золоту лампу, которая парит на месте и исцеляет всех союзников внутри её ауры
			Нажмите ПКМ, чтобы призвать нефритовую лампу, которая увеличивает урон и защиту всех союзников внутри её ауры
			Одновременно может существовать только одна лампа
			'''
	}

	OldViperChestplate: {
		DisplayName: Древний куртка гадюки
		Tooltip:
			'''
			Увеличивает метательный урон на 10%
			Увеличивает скорость метательных снарядов на 20%
			'''
	}

	OldViperHelmet: {
		DisplayName: Древний Древний шлем гадюки
		Tooltip:
			'''
			Увеличивает урон метателя на 10%
			Даёт 33% шанс не использовать метательный предмет
			Увеличивает максимальное число очков техники на 2
			'''
	}

	OldViperLegs: {
		DisplayName: Древние штаны гадюки
		Tooltip:
			'''
			Увеличивает метательный урон на 10%
			Увеличивает метательный шанс критического удара на 15%
			Увеличивает скорость передвижения на 15%
			'''
	}

	ViperChestplate: {
		DisplayName: Куртка гадюки
		Tooltip:
			'''
			Увеличивает метательный урон на 10%
			Увеличивает скорость метательных снарядов на 20%
			'''
	}

	ViperHelmet: {
		DisplayName: Шлем гадюки
		Tooltip:
			'''
			Увеличивает урон метателя на 10%
			Даёт 33% шанс не использовать метательный предмет
			Увеличивает максимальное число очков техники на 2
			'''
		SetBonus:
			'''
			Метательный урон с 10% шансом накладывает дебафф [cbuff:Poisoned]
			Ближайшие враги получают больше урона от дебаффов [cbuff:Poisoned] и [cbuff:Venom] 
			'''
	}

	ViperLegs: {
