	StellarSabre: {
		DisplayName: Звёздная сабля
		Tooltip: ""

		Progression: {
			WoF:
				'''
				Одержи победу над хранителем Преисподней, чтобы обрести большую силу...
				Новая сила не была обретена...
				'''
			Mechs:
				'''
				С победой над Стеной плоти эта сабля стреляет особыми звездами
				Одержи победу над механическими чудовищами, чтобы обрести большую силу...
				'''
			Plantera:
				'''
				После поражения машин Дрэйдона, сабля накладывает дебафф [cbuff:CalamityMod/AstralInfectionDebuff]
				Одержи победу над хранительницей джунглей, чтобы обрести большую силу...
				'''
			Golem:
				'''
				С победой над Плантерой звёзды разлетаются при попадании
				Одержи победу над творением храма яхщеров, чтобы обрести большую силу...
				'''
			Cultist:
				'''
				После поражения Голема звёзды самонаводятся на врагов
				Через некоторое время звёзды распадаются
				Одержи победу над лидером древнего культа, чтобы обрести большую силу...
				'''
			MoonLord:
				'''
				С победой над Безумным Культистом звёзды взрываются со временем
				Одержи победу над трупом злого бога, чтобы обрести большую силу...
				'''
			Full:
				'''
				Звёздная сабля полностью пробудилась, и её способности были ещё больше усилены
				Истинная мощь оружия раскрыта на максимум!
				'''
		}

		Lore: "'Даже после всего случившегося, оставался один человек, на которого Ксандер отказывался нападать...'"
	}

	ExoSights: {
		DisplayName: Экзо-прицел
		Tooltip: ""
		SOTSBardHealerTooltip:
			'''
			Увеличивает шанс критического удара на 15%, не складывается с предыдущими улучшениями
			Критические удары наносят на 40 ед. больше урона, вызывают вспышку разрушительных искр и могут подрывать врагов, нанося 100% урона
			Бонус к урону начинается с 15 ед. и обратно пропорционален скорости использования предмета
			Текущий бонус {0} ед.
			Критические удары крадут здоровье, восстанавливают пустоту, ману и возвращают вдохновение
			Нажатие клавиши '{$ThoriumMod.Keybinds.AccessoryAbility.DisplayName}' наделит вас гарантированным критическим попаданием на 10 секунд
