	TyrantYharimsUltisword: {
		DisplayName: Пенетратор тирана
		Tooltip:
			'''
			Бросает ауритовый огромный меч, пронзающий, поджигающий и замедляющий врагов
			В одного врага может одновременно вонзиться до пяти клинков
			Последующие попадания сверх этого числа выбивают ранее вонзённые клинки
			Нажмите <right>, чтобы войти в стойку, в которой нажатие <left> позволяет совершить колоссальный, сокрушительный взмах
			В этой стойке увеличивается регенерация здоровья и время полёта, а перезарядка рывков сокращается
			Сокрушительному взмаху требуется перезарядка после использования
			Удар взмахом по пронзённому врагу запускает все клинки и мгновенно подготавливает следующий взмах
			На последнего врага, поражённого сокрушительным взмахом, накладывается метка смерти
			При выходе из стойки метка смерти взрывается, нанося колоссальный урон
			'Наград за становление богоискателем...'
			'''
	}

