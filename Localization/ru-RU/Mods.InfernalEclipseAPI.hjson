		MergeCraftingTrees: {
			Label: Объединить деревья крафта
			Tooltip: Объединяет деревья крафта для похожих предметов из нескольких модов и добавляет кросс-модовые материалы в рецепты некоторых предметов.
		}

		BloodOrbPotionDuplication: {
			Label: Дублирование зелий из кровавых сфер
			Tooltip: Заменяет рецепты зелий из кровавых сфер на рецепты их дублирования.
		}

		ChanageWeaponClasses: {
			Label: Изменение классов оружия
			Tooltip: Изменяет класс некоторого оружия, чтобы добавить больше разнообразия или сделать его более логичным.
		}

		DisplayWorldEntryMessages: {
			Label: Показывать сообщения при входе в мир
			Tooltip: Включает или выключает сообщения, появляющиеся при входе в мир.
		}

		EnableInterlude4: {
			Label: Интерлюдия 4
			Tooltip:
				'''
				Проигрывает «Interlude 4» после победы над Экзо-механизмами и Высшей Каламитас.
				Эта мелодия будет иметь приоритет над «Their Fabricator» и «Acceptance».
				'''
		}

		AdjustAdvisorSpawnConditions: {
			Label: Изменить условия появления Аналитика
			Tooltip:
				'''
				Изменяет условия появления Аналитика, чтобы он не был постоянно активен в мире.
				Полезно, если вы используете полосу здоровья боссов из Infernum и не хотите, чтобы она была постоянно активна из-за Аналитика.
				Это вызывает проблемы в мультиплеере, поэтому отключите эту настройку, если планируете играть в мультиплеер.
				'''
		}

		MultiplayerBossRespawnTimer: {
			Label: Время возрождения в мультиплеере
			Tooltip: Как долго будет длиться возрождение во время боя с боссом.
		}

		MinimumDifficultyToPreventRespawns: {
			Label: Минимальная сложность предотвращения возрождения
			Tooltip: Минимальная сложность для включения системы предотвращения возрождения.
		}

		MultiplayerRespawnsAllowed: {
			Label: Количество возрождений в мультиплеере
			Tooltip: Количество возрождений во время сражения с боссами.
		}

		NerfThoriumMulticlass: {
			Label: Ослабить мультикласс Thorium
			Tooltip: Добавляет системы, которые не позволяют использовать барда и целителя играя за мультикласс и становиться слишком сильным.
		}

		ColoredRelics: {
			Label: Цветные реликвии
			Tooltip: Разукрашивает реликвии из этого мода
		}

		ForceMenu: {
			Label: Принудительная тема меню
			Tooltip: Принудительно выбирает тему меню «Infernal Eclipse of Ragnarok» при загрузке игры.
		}

		AutomatedConfigSetup: {
			Label: Автоматическая настройка конфигураций
			Tooltip: Автоматически настраивает конфигурации некоторых других модов в соответствии с требованиями модпака «Infernal Eclipse of Ragnarok».
		}

		MoveDeerclopsChecklistEntry: {
			Label: Передвинуть Циклоп-оленя в чек-листе
			Tooltip: Циклоп-олень теперь стоит перед Скелетроном в чек-листе, чтобы соответствовать уровню Calamity и Infernum.
		}

		DontEnableThis: {
			Label: Не включай это
			Tooltip: Это, вероятно, даст вам неверное представление и приведёт к несбалансированному и нарушенному геймплею
		}

		CalamityExpertAccessories: {
			Label: Аксессуары режима Эксперт из Calamity
			Tooltip: Нектороые аксессуары с боссов Calamity можно получить только в режиме Эксперт и выше.
		}

		ThereIsNoReasonDisableThis: {
			Label: Нет причин отключать это
			Tooltip:
				'''
				Нет причин отключать эту настройку, так как она отключает режимы, которые становятся багованными и несбалансированными при объединении с Infernum.
				Отключайте этот конфиг, только если вы осознаёте последствия, и не сообщайте об ошибках при отключённом конфиге.
				'''
		}

		DeveloperMode: {
			// Label: Developer Mode
			// Tooltip: Toggles the availablity of tools useful for development.
		}

		ForceRagnarokInfernumModeInSubworlds: {
			// Label: Force Ragnarok Mode and Infernum Mode In Subworlds
			/* Tooltip:
				'''
				Automatically enables either Infernum Mode or Ragnarok Mode based on your worlds vanilla difficuly.
