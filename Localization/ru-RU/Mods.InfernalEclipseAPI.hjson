	Lycanroc: {
		DisplayName: Лайканрок
		Tooltip: ""

		Progression: {
			WoF:
				'''
				Одержи победу над хранителем Преисподней, чтобы обрести большую силу...
				Новая сила не была обретена...
				'''
			Mechs:
				'''
				С победой над Стеной плоти пули, выпущенные этим оружием, накладывают дебафф [cbuff:CalamityMod/Crumbling]
				Одержи победу над механическими чудовищами, чтобы обрести большую силу...
				'''
			Plantera:
				'''
				После поражения машин Дрэйдона это оружие превращает обычные пули в высокоскоростные
				Одержи победу над хранительницей джунглей, чтобы обрести большую силу...
				'''
			Golem:
				'''
				С победой над Плантерой в режиме ярость теперь это оружие стреляет невероятно быстро
				Одержи победу над творением храма яхщеров, чтобы обрести большую силу...
				'''
			Cultist:
				'''
				После поражения Голема, в режиме адреналин вы гарантированно наносите критические удары.
				Одержи победу над лидером древнего культа, чтобы обрести большую силу...
				'''
			MoonLord:
				'''
				С победой над Культистом-лунатиком это оружие может нанести суперкритический удар
				Одержи победу над трупом злого бога, чтобы обрести большую силу...
				'''
			Full: Лайканрок полностью пробудился, и его мощь раскрыта на максимум!
		}

		Lore: "'И что ты сделаешь? Убьёшь меня?'"
	}

