	SkybreakerCoil: {
		DisplayName: Неборвущая катушка
		Tooltip:
			'''
			Следующая атака миньона по поражённому ударом этого хлыста врагу нанесёт в 1,3 раза больше урона и выпустит электрические разряды
			Электрические разряды кратковременно электрифицируют ближайших врагов и игнорируют их броню
			'''
	}

	Milkyway: {
		DisplayName: Млечный путь
		Tooltip:
			'''
			+10 ед. урона от метки призывателя за каждый стак
			Следующая атака миньона по поражённому ударом этого хлыста врагу нанесёт 1 гарантированный критический удар с 4-кратно увеличенным уроном
			Урон от меток этого хлыста способен суммироваться сам с собой
			Более ранние стаки снимаются раньше
			Кометы, количество которых равно количеству стаков, начинают вращаются вокруг врага при попадании по нему
			'''
	}

