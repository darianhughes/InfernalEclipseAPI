}

Items: {
	CapeoftheSurvivor: {
		DisplayName: Плащ выжившего
		Tooltip:
			'''
			'В этом плаще соткана магия, которая поможет вам преодолеть даже самые тяжёлые дни'
			Вы быстро накапливаете сопротивление урону до 15% с течением времени
			При получении удара этот бонус временно снижается до -10% сопротивления урону
			Пока этот бонус выше 0%, вы получаете до 2 единиц восполнения здоровья
			'''
	}

