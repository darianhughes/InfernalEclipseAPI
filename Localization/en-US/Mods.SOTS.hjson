VisionAmuletTextList: {
	2: [s:InfernalEclipseAPI/IEoRIcon] Increases attack speed by 8%
	3: [s:InfernalEclipseAPI/IEoRIcon] Increases critical strike chance by 4%, and is improved to 8% after beating the guardian of the underworld
	4: [s:InfernalEclipseAPI/IEoRIcon] Increases critical strike damage by 8%, and is improved to 12% after beating the guardian of the underworld
	6:
		'''
		Increases max life by 20
		[s:InfernalEclipseAPI/IEoRIcon] Increases damage by 5%, and is improved to 10% after beating the guardian of the underworld
		'''
}

VisionAmuletTextList2: {
	1:
		'''

		[s:InfernalEclipseAPI/IEoRIcon] Decreases mana cost by 15%, and is improved to 20% after beating the guardian of the underworld
		'''
	2:
		'''

		[s:InfernalEclipseAPI/IEoRIcon] Increases melee speed and movement speed by 8%
		Increases jump speed
		'''
	3:
		'''

		Provides access to Work Bench, Furnace, and Anvil crafting stations
		[s:InfernalEclipseAPI/IEoRIcon] Provides access to the Alchemy Table crafting station as well after beating the guardian of the underworld
		Increases max mana and mana received from potions by 40
		'''
	4:
		'''

		[s:InfernalEclipseAPI/IEoRIcon] Increases all damage by 10% of the increases received to any other damage type from other sources
		'''
	5:
		'''

		[s:InfernalEclipseAPI/IEoRIcon] Efficacy of enemy defense is reduced by 5%, and is improved to 10% after beating the guardian of the underworld
		'''
}

NPCs.CorpseBloom.DisplayName: Rotbloom

Items: {
	Sharanga.DisplayName: Kodanda
	Dreamcatcher.DisplayName: Dream Talisman
	EnchantedPickaxe.DisplayName: Mystic Pickaxe
	VigorPotion.Tooltip: Grants the ability to dash 25 times
	HarvestersScythe.Tooltip:
		'''
		Increases critical strike damage by 5%
		Enemies have a 10% chance to drop double the loot, or 20% when killed by critical strike
		'''
	RockCandy.Tooltip:
		'''
		[s:InfernalEclipseAPI/IEoRIcon] Increases pickaxe power by 4
		Increases mining speed, melee speed, and movement speed by 5%
		'''
	HydrokineticAntennae.Tooltip:
		'''
		Use hydrokinesis to extend the effective range of melee weapons and other low-reach items, such as whips
		[s:InfernalEclipseAPI/IEoRIcon] Decreases true melee damage by 15%
		'''
	FrostArtifactHelmet.Tooltip: [s:InfernalEclipseAPI/IEoRIcon] 15% increased melee and ranged damage
	FrostArtifactChestplate.Tooltip: [s:InfernalEclipseAPI/IEoRIcon] 15% increased melee and ranged critical strike chance

	ElementalBreastplate: {
		DisplayName: Elemental Breastplate
		Tooltip:
			'''
			Increases melee and summon damage by 10%
			Increases life regeneration by 4
			Press '{0}' to teleport to your cursor, dealing 200% of your defense as damage to all enemies in your path
			Has a 15 second cooldown, but increases melee speed by 40% during the cooldown
			'''
	}

	TwilightAssassinsCirclet.Tooltip:
		'''
		[s:InfernalEclipseAPI/IEoRIcon] Increases max sentries by 1
		Increases minion and melee damage by 7%
		Increases max void by 50
		Provides a Holo Eye minion to assist in combat
		Press '{0}' to make it launch a destabilizing beam that applies 4 levels of destabilized, but only once per enemy
		Destabilized enemies gain a 5% flat chance to be critically striked
		Costs 6 void to launch
		Holo Eye remains active in the inventory when favorited or while worn in vanity slots, but cannot attack
		'''
	ChallengerRing.I6: [s:InfernalEclipseAPI/IEoRIcon] Weapons will inflict a random debuff on hit
}

